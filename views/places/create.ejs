<% layout("layouts/app")%>
<h1>Add Places</h1>
<form action="/places" method="post">
  <div>
    <label for="title">Title:</label>
    <input type="text" id="title" name="place[title]" required />
  </div>
  <div>
    <label for="location">Location:</label>
    <input type="text" id="location" name="place[location]" required />
  </div>
  <div>
    <label for="price">Price:</label>
    <input type="number" id="price" name="place[price]" min="0" required />
  </div>
  <div>
    <label for="image">Image:</label>
    <input type="text" id="image" name="place[image]" required />
  </div>
  <div>
    <label for="description">Description:</label>
    <input type="text" id="description" name="place[description]" required />
  </div>
  <button type="submit" id="">Submit</button>
</form>
