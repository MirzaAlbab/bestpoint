<% layout("layouts/app")%>
<h1>Edit Places</h1>
<form action="/places/<%=place._id%>?_method=PUT" method="post">
  <div>
    <label for="title">Title:</label>
    <input
      type="text"
      id="title"
      name="place[title]"
      required
      value="<%=place.title%>"
    />
  </div>
  <div>
    <label for="location">Location:</label>
    <input
      type="text"
      id="location"
      name="place[location]"
      required
      value="<%=place.location%>"
    />
  </div>
  <div>
    <label for="price">Price:</label>
    <input
      type="number"
      id="price"
      name="place[price]"
      min="0"
      required
      value="<%=place.price%>"
    />
  </div>
  <div>
    <label for="image">Image:</label>
    <input
      type="text"
      id="image"
      name="place[image]"
      required
      value="<%=place.image%>"
    />
  </div>
  <div>
    <label for="description">Description:</label>
    <input
      type="text"
      id="description"
      name="place[description]"
      required
      value="<%=place.description%>"
    />
  </div>
  <button type="submit" id="">Submit</button>
</form>
