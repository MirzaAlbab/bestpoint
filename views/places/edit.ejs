<% layout("layouts/app")%>
<div class="row mb-5">
  <div class="col-6 <%= !place.images.length>0 ? 'offset-3': ''%>">
    <h3>Edit place</h3>
    <form
      action="/places/<%=place._id%>?_method=PUT"
      method="post"
      class="validation-form"
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input
          type="text"
          id="title"
          name="place[title]"
          required
          class="form-control"
          value="<%=place.title%>"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please fill out this field.</div>
      </div>
      <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input
          type="text"
          id="location"
          name="place[location]"
          required
          class="form-control"
          value="<%=place.location%>"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please fill out this field.</div>
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <input
          type="text"
          id="price"
          name="place[price]"
          min="0"
          required
          class="form-control"
          value="<%=place.price%>"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please fill out this field.</div>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Image:</label>
        <input
          type="file"
          name="image"
          id="image"
          accept="image/*"
          multiple
          class="form-control"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please fill out this field.</div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <input
          type="text"
          id="description"
          name="place[description]"
          required
          class="form-control"
          value="<%=place.description%>"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please fill out this field.</div>
      </div>
      <button type="submit" class="btn btn-success" id="">Submit</button>
    </form>
  </div>
  <% if(place.images.length > 0) { %>
  <div class="col-6">
    <h5>Delete Images</h5>
    <div class="form-group form-check">
      <input type="checkbox" id="checkAll" class="form-check-input" />
      <label for="checkall" class="form-check-label">Check All</label>
    </div>
    <form
      action="/places/<%=place._id%>/images?_method=DELETE"
      method="post"
      class="d-flex flex-wrap"
    >
      <% place.images.forEach((image,index)=> {%>

      <div class="col-md-4">
        <div class="card mb-3">
          <img src="/images/<%=image.filename%>" class="card-img-top" alt="" />
          <div class="card-body">
            <label class="custom-checkbox">
              <input type="checkbox" name="images[]" value="<%=image.url%>" />
              <span class="custom-checkbox-text">Pilih</span>
            </label>
          </div>
        </div>
      </div>

      <% }) %>
      <div class="w-100"></div>
      <button type="submit" class="btn btn-danger" id="">Delete</button>
    </form>
  </div>
  <% } %>
</div>

<script>
  document.getElementById("checkAll").addEventListener("change", function () {
    const checkboxes = document.getElementsByName("images[]");
    for (let i = 0; i < checkboxes.length; i++) {
      checkboxes[i].checked = this.checked;
    }
  });
</script>
