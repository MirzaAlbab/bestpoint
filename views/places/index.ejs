<% layout("layouts/app")%>
<h2>All Places</h2>
<ul>
  <% for (const place of places) { %>
  <div class="card mb-3">
    <div class="row no-gutters">
      <div class="col-md-4">
        <% if(place.images.length){ %>
        <img
          src="/images/<%= place.images[0].filename %>"
          class="card-img"
          alt="..."
        />
        <% } else { %>
        <img
          src="https://source.unsplash.com/collection/2349781/1280x720"
          alt="<%= place.title %>"
          class="img-fluid"
        />
        <% } %>
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h5 class="card-title"><%= place.title %></h5>
          <p class="card-text"><%= place.location %></p>
          <p class="card-text">
            <small class="text-secondary"><%= place.description %></small>
          </p>
          <a href="/places/<%=place._id%>" class="btn btn-primary">View</a>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</ul>
