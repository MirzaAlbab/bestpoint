<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bestpoint - Places</title>
  </head>
  <body>
    <h2>All Places</h2>

    <a href="/places/new">Add Places</a>
    <ul>
      <% for (const place of places) { %>
      <li><a href="/places/<%=place._id%>"><%= place.title %></a></li>
      <% } %>
    </ul>
  </body>
</html>
